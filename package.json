{
  "name": "exerly-fitness",
  "version": "1.0.0",
  "description": "Exerly Fitness monorepo with API, web dashboard, and iOS app",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:all": "npm run dev",
    "dev:api": "npm start --prefix apps/api",
    "dev:web": "npm start --prefix apps/web",
    "local": "concurrently -n api,web -c blue,green \"npm run local:api\" \"npm run dev:web\"",
    "local:all": "npm run local",
    "local:api": "npm run start:local --prefix apps/api",
    "install:all": "npm install && npm install --prefix apps/api && npm install --prefix apps/web",
    "build:web": "npm run build --prefix apps/web",
    "start:api": "npm start --prefix apps/api",
    "ios": "npm run ios:build",
    "ios:build": "bash scripts/ios.sh build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p apps/web",
    "test": "npm test -w apps/api",
    "smoke:api": "bash scripts/smoke-api.sh",
    "prepare": "husky",
    "test:mongo": "node scripts/test-mongo.cjs",
    "test:web": "playwright test",
    "test:web:offline": "playwright test --config playwright.offline.config.cjs",
    "test:cross-client": "bash scripts/test-cross-client.sh",
    "ios:test": "bash scripts/ios.sh test",
    "ios:release-check": "bash scripts/ios.sh release-check"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "husky": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=22.0.0 <27"
  }
}
