# Point the web app at a specific API. Leave unset for the default, which is
# the API on the same host in development and the deployed API otherwise.
VITE_API_URL=http://localhost:3001

# Port the API listens on, used when VITE_API_URL is unset and the page is
# served from a private address (localhost, LAN, or the tailnet).
# VITE_API_PORT=3001

VITE_ADMIN_EMAILS=admin@example.com
VITE_ENV=development
