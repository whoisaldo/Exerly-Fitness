# ---- Core ----
PORT=3001
# Required in production. Without it the server refuses to start rather than
# signing tokens with a value that is in the public repo.
JWT_SECRET=your-jwt-secret-here
ADMIN_EMAILS=admin@example.com

# ---- Storage ----
# Set DB_MODE=local to run on SQLite with no external services (offline dev).
# Anything else requires MONGODB_URI.
# DB_MODE=local
# Where the SQLite file lives in local mode. Defaults to ./fitness-local.db.
# SQLITE_FILE=./fitness-local.db
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/exerly

# ---- AI coach ----
# Without a key the coach returns canned responses and spends no credits.
GEMINI_API_KEY=your-gemini-api-key

# ---- Food data (optional) ----
# FatSecret gives better coverage and real serving sizes. Barcode lookup and
# search both fall back to Open Food Facts when these are unset.
# FATSECRET_CLIENT_ID=your-fatsecret-client-id
# FATSECRET_CLIENT_SECRET=your-fatsecret-client-secret

# ---- Optional ----
# Extra browser origins allowed through CORS, comma separated.
# EXTRA_CORS_ORIGINS=https://staging.example.com
# How long an access token lasts. Default 30d, refreshed on app launch.
# JWT_EXPIRES_IN=30d
